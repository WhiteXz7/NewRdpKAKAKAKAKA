-- Cole no Roblox Studio (Command Bar) com um personagem R6 selecionado.
local character = script.Parent
if not character:FindFirstChildOfClass('Humanoid') then
    character = game.Players.LocalPlayer.Character or workspace:FindFirstChildOfClass('Model')
end
local humanoid = character:FindFirstChildOfClass('Humanoid')
local animator = humanoid:WaitForChild('Animator')

local function build(name, frames, priority)
    local kfs = Instance.new('KeyframeSequence')
    kfs.Name = name
    kfs.Loop = true
    kfs.Priority = priority
    for fi, fr in ipairs(frames) do
        local key = Instance.new('Keyframe')
        key.Time = (fi - 1) / (30)
        key.Parent = kfs
        for motor, angles in pairs(fr) do
            local pose = Instance.new('Pose')
            pose.Name = motor
            pose.CFrame = CFrame.Angles(angles[1], angles[2], angles[3])
            pose.Parent = key
        end
    end
    return kfs
end

